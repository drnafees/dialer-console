    {
      "name": "2 Incremental sync",
      "item": [
        {
          "name": "GET leads modified since cursor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/leads?filters=%7B%22lastModifiedTime%22%3A%7B%22%24gt%22%3A%22{{cursor}}%22%7D%7D&sortProperty=lastModifiedTime&sortDirection=ASC&pageSize=100&includeMeta=true",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "leads"],
              "query": [
                { "key": "filters", "value": "{\"lastModifiedTime\":{\"$gt\":\"{{cursor}}\"}}" },
                { "key": "sortProperty", "value": "lastModifiedTime" },
                { "key": "sortDirection", "value": "ASC" },
                { "key": "pageSize", "value": "100" },
                { "key": "includeMeta", "value": "true" }
              ]
            },
            "description": "Incremental sync pattern: fetch leads modified after the `cursor` collection variable, ascending. The pre-request script seeds the cursor to 7 days ago when unset; the test advances it to the newest lastModifiedTime seen. Re-run to fetch only new changes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('cursor')) {",
                  "    var d = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);",
                  "    pm.collectionVariables.set('cursor', d.toISOString());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "var rows = Array.isArray(body) ? body : (body.data || []);",
                  "var max = pm.collectionVariables.get('cursor');",
                  "rows.forEach(function (r) { if (r.lastModifiedTime && r.lastModifiedTime > max) { max = r.lastModifiedTime; } });",
                  "pm.collectionVariables.set('cursor', max);",
                  "console.log('cursor ->', max, '(' + rows.length + ' rows)');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
